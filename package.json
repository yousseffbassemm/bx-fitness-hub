{
  "name": "bx-fitness-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:watch": "scripts/dev-watchdog.sh start",
    "dev:stop": "scripts/dev-watchdog.sh stop",
    "dev:status": "scripts/dev-watchdog.sh status",
    "dev:log": "scripts/dev-watchdog.sh log",
    "dev:url": "scripts/dev-watchdog.sh url",
    "tunnel:on": "scripts/dev-watchdog.sh tunnel on",
    "tunnel:off": "scripts/dev-watchdog.sh tunnel off",
    "tunnel:status": "scripts/dev-watchdog.sh tunnel status",
    "backup": "node scripts/backup.mjs",
    "backup:list": "node scripts/backup.mjs --list",
    "restore": "node scripts/restore.mjs",
    "test": "node --import ./tests/support/register.mjs --test tests/"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
