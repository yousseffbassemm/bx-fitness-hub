# --- The site's own address ---------------------------------------------
#
# What the page tells OpenGraph, the JSON-LD and metadataBase it is. Sharing
# a link anywhere fetches the preview image from here, so if this is wrong
# the preview comes back empty.
#
# BX has no domain yet. Left unset this falls back to http://localhost:3000,
# which is honest about being a development machine. Set it the moment there
# is a real address - no trailing slash.
# NEXT_PUBLIC_SITE_URL=https://the-real-domain.com

# Class bookings.
#
# Left unset, bookings are stored in SQLite at .data/bookings.db using Node's
# built-in driver. That is real, durable storage and needs no setup - right
# for one server, wrong for serverless or more than one instance, because
# each instance would own a separate file.
#
# Set both of these and the app switches to Supabase automatically. Run
# supabase/schema.sql there first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: move the SQLite file somewhere else, e.g. onto a mounted volume.
# BOOKINGS_DB_PATH=/var/lib/bx/bookings.db

# --- Staff area (/staff) ------------------------------------------------
# Generate both with:  node scripts/staff-password.mjs "<password>"
#
# Without these the staff area shows a notice and refuses every login, which
# is deliberate: a booking list with no password is worse than no list.
# Note the hash uses dots, not dollars - .env files expand $NAME and would
# silently truncate it.
# Staff accounts live in the database, not here - create one with:
#   node scripts/staff-user.mjs add <username>
# At least 32 characters. Changing it signs everyone out.
STAFF_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Telling somebody an enquiry arrived (optional)
#
# Without these the site works exactly as it does now: enquiries are saved and
# read on the Enquiries screen. With them, an email goes out as well, so
# nobody has to remember to look. Also used when a waitlist place comes free.
#
# A key from resend.com, and the address it should land at. NOTIFY_EMAIL_FROM
# has to be a sender that provider has verified for your domain.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=

# ---------------------------------------------------------------------------
# Live Google reviews (optional)
#
# Unset, the site shows the twelve reviews read by hand into site.ts. Set,
# they come from Google and refresh daily.
#
# Worth knowing before you turn it on: the Places API returns at most five
# reviews, Google chooses which, and it may include a critical one. You are
# trading twelve curated five-star reviews for five live ones you do not pick.
#
# The key needs Places API (New) enabled and billing on the Google Cloud
# project. GOOGLE_PLACE_ID is the place's ID, not the short maps.app.goo.gl
# link - find it with the Place ID Finder.
# ---------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
